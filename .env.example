# ===================================================================
# Student Performance Analysis System (SPAS) - Environment Variables
# Copy this file to .env and configure for your deployment environment
# ===================================================================

# Spring Active Profile (prod for production, default for local development)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
DB_NAME=spas_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here
# DATABASE_URL supports standard JDBC format or cloud provider URI (postgres:// or postgresql://)
DATABASE_URL=jdbc:postgresql://postgres:5432/spas_db

# Flyway Migrations (true enables automated schema migrations on startup)
FLYWAY_ENABLED=true

# JWT Authentication Secret (MUST be at least 256 bits / 32+ characters)
# Generate via: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_randomly_generated_base64_jwt_secret_key_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# Initial Root Administrator Account Seed (Configured on initial fresh start)
ADMIN_EMAIL=admin@spas.edu
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!
ADMIN_IDENTIFIER=ADMIN001
ADMIN_FULL_NAME=System Administrator

# CORS Allowed Origins (Comma-separated explicit origin URLs; wildcard '*' is strictly forbidden when credentials are enabled)
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# Frontend API Target (for local or proxy environments)
VITE_API_BASE_URL=/api
